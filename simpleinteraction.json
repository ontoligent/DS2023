87\n4          65      87\n5          15      87","content_type":"text/plain"}}},"children":[],"key":"YEgPbN2s06"}],"key":"yYKHXnBE7Q"}],"key":"mTcNvydJ95"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"ppvc = price_point.value_counts(['price','points']).sort_index().unstack(fill_value=0)","key":"qG0R5xPxFr"},{"type":"outputs","id":"6_8ti231Ntgk7XCroVwQU","children":[],"key":"owgNJkrUIR"}],"key":"weADC7IFyo"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"@interact(\n    # price=sorted(price_point.price.unique())\n    price=(5,1000,5)\n)\ndef plot_median_points(price = 20):\n    fig, ax = plt.subplots()\n    plt.xlim(80,100)\n    try:\n        S = ppvc.loc[price]\n    except KeyError as e:\n        ax.text(.5, .5, f\"{price} not found in dataset.\", transform=ax.transAxes, ha='center', va='center', fontsize=18)\n        plt.xlim(80,100)\n        return \n    S.plot.bar(rot=0, color=[('tab:red' if x == S.idxmax() else 'lightgray') for x in S.index], ax=ax)\n    plt.title(f\"Distribution of Points for ${price} Wines\")\n    plt.show()","key":"sqtFN4LaHx"},{"type":"outputs","id":"y_JksqwnUip_eaZNUjvxD","children":[{"type":"output","jupyter_data":{"output_type":"display_data","metadata":{},"data":{"application/vnd.jupyter.widget-view+json":{"content":"{\"model_id\":\"1f4a76a502ef460b852b6acfa69908ae\",\"version_major\":2,\"version_minor\":0}","content_type":"application/vnd.jupyter.widget-view+json"},"text/plain":{"content":"interactive(children=(IntSlider(value=20, description='price', max=1000, min=5, step=5), Output()), _dom_class…","content_type":"text/plain"}}},"children":[],"key":"w3hehmi26Q"}],"key":"dbs1sOYtEP"}],"key":"FbVFQtUcI1"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Note that neither a histogram