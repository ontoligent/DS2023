":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"ZBAYJVGcFF"}],"urlSource":"https://eco3min.fr/en/us-children-vs-adults-65-and-older/","key":"KqkivaW6OZ"}],"key":"HiwfyZASHv"}],"visibility":"show","key":"svQXsT29v6"},{"type":"block","kind":"notebook-code","data":{"deletable":true,"editable":true,"slideshow":{"slide_type":"slide"},"tags":[]},"children":[{"type":"code","lang":"python","executable":true,"value":"ax = coal_and_oil.plot.area(stacked=False)\n\n# Create a new series based on the minimumn value of coal vs oil\n# and plot its area\ncoal_and_oil.min(axis=1).plot.area(color='white', ax=ax)\n\nlines = ax.get_lines()\n\n# Coal line\nlines[0].set_color('tab:blue')\nlines[0].set_linewidth(2)\n\n# Oil line\nlines[1].set_color('tab:orange')\nlines[1].set_linewidth(2)\n\n# Mask line (hidden)\nlines[2].set_linewidth(0)\n\nplt.show()","visibility":"show","key":"wfKjHrGkxb"},{"type":"outputs","id":"gtCTaglc8AH656PmjxLHq","children":[{"type":"output","jupyter_data":{"output_type":"display_data","metadata":{},"data":{"image/png":{"content_type":"image/png","hash":"8d00f85b552c5092e81a913098ddb8ef","path":"/DS2023//build/8d00f85b552c5092e81a913098ddb8ef.png"},"text/plain":{"content":"<Figure size 640x480 with 1 Axes>","content_type":"text/plain"}}},"children":[],"key":"IV1ErAqHkq"}],"visibility":"show","key":"GFEj9yDHFc"}],"visibility":"show","key":"amBeai53jb"},{"type":"block","kind":"notebook-content","data":{"deletable":true,"editable":true,"slideshow":{"slide_type":"slide"},"tags":[]},"children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"If we want to avoid the gray lines on the right and left, we can use Matplotlib’s ","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"nNeqm4G0hp"},{"type":"inlineCode","value":"ax.fill_between()","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"d9S9u0Hc2B"},{"type":"text","value":" method.","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"ZdrfzcaX7M"}],"key":"HI8BnVjEdt"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"To use this method, we create a pure Matplotlib plot.","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"iIGRSW9U2s"}],"key":"ijkNK1C4rd"}],"visibility":"show","key":"Q7DnPozMxI"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"# Instantiate our figure and axes objects\nfig, ax = plt.subplots()\n\n# Get our data to map \nyears = coal_and_oil.index\ncoal = coal_and_oil['coal']\noil = coal_and_oil['oil']\n\n# Plot 1: Fill the gap when coal exceeds oil\nax.fill_between(years, oil, coal, where = coal >= oil, interpolate=True,\n                color='tab:blue', alpha=0.5, lw=2, label='coal')\n\n# Plot 2: Fill the gap when oil exceeds coal\nax.fill_between(years, coal, oil, where = oil > coal, interpolate=True,\n                color='tab:orange', alpha=0.5, lw=2, label='oil')\n\nax.set_xlabel('year')\nax.legend()\nplt.show()","key":"zfgmVzMrHK"},{"type":"outputs","id":"O_kw00FJXlcAtWKyCRqil","children":[{"type":"output","jupyter_data":{"output_type":"display_data","metadata":{},"data":{"image/png":{"content_type":"image/png","hash":"0091acacf4373535a554fe852a3e93a2","path":"/DS2023//build/0091acacf4373535a554fe852a3e93a2.png"},"text/plain":{"content":"<Figure size 640x480 with 1 Axes>","content_type":"text/plain"}}},"children":[],"key":"qeWtxghpBd"}],"key":"aqTefZ8Rn3"}],"key":"yhtnd4hs6P"},{"type":"block","kind":"notebook-content","data":{"deletable":true,"editable":true,"slideshow":{"slide_type":"slide"},"tags":[]},"children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Caveats","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"ke