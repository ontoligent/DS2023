nd":{"line":12,"column":1}},"children":[{"type":"text","value":"But instead of using binning and counting, it estimates a probability density function using more sophisticated methods, such as kernel estimation.","position":{"start":{"line":12,"column":1},"end":{"line":12,"column":1}},"key":"ynjSIbV4QJ"}],"key":"NB1qMsx9mb"},{"type":"paragraph","position":{"start":{"line":14,"column":1},"end":{"line":14,"column":1}},"children":[{"type":"text","value":"This function is represented a line graph, as opposed to a bar chart.","position":{"start":{"line":14,"column":1},"end":{"line":14,"column":1}},"key":"QgWrzfoa8K"}],"key":"JusiQmkD4t"},{"type":"paragraph","position":{"start":{"line":16,"column":1},"end":{"line":16,"column":1}},"children":[{"type":"text","value":"A density plot may be thought of as a special case of a line graph where the x axis represents an increasing numeric value, and the y axis represents an estimate or frequency. However, the density plot does not represent a trend. Instead, it is more like the function use case.","position":{"start":{"line":16,"column":1},"end":{"line":16,"column":1}},"key":"S0vXQcy3tj"}],"key":"J5atcpL2qY"},{"type":"paragraph","position":{"start":{"line":18,"column":1},"end":{"line":18,"column":1}},"children":[{"type":"text","value":"Like line graphs, they may also be rendered as area charts to show accumulation.","position":{"start":{"line":18,"column":1},"end":{"line":18,"column":1}},"key":"Te4vbz5ecB"}],"key":"m874ui0bli"}],"key":"vxSwDx4BMX"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Use Cases","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"AmmZTr4I6M"}],"identifier":"use-cases","label":"Use Cases","html_id":"use-cases","implicit":true,"key":"QBF33qAJgU"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"Like histograms, density plots provide a quick way to inspect the centrality and dispersion of a distribution.","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"YGMdP8voO9"}],"key":"TLw2BY8dso"},{"type":"paragraph","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"children":[{"type":"text","value":"They allow you to inspect the shape of a distribution for modality, skew, and kurtosis.","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"rVhzcBwvgk"}],"key":"okV3e1CHmz"},{"type":"paragraph","position":{"start":{"line":7,"column":1},"end":{"line":7,"column":1}},"children":[{"type":"text","value":"They can also surface outliers and mutliple populations.","position":{"start":{"line":7,"column":1},"end":{"line":7,"column":1}},"key":"dzB65vlQaf"}],"key":"s57SyEshVa"},{"type":"paragraph","position":{"start":{"line":9,"column":1},"end":{"line":9,"column":1}},"children":[{"type":"text","value":"Beyond histograms, density plots are more opiniated, as it were, in suggesting a function behind the empirical distribution.","position":{"start":{"line":9,"column":1},"end":{"line":9,"column":1}},"key":"YP6i3IHV6b"}],"key":"gi9rAR3qx2"},{"type":"paragraph","position":{"start":{"line":11,"column":1},"end":{"line":11,"column":1}},"children":[{"type":"text","value":"Instead of showing counts, it shows the denstity of data points within a given range.","position":{"start":{"line":11,"column":1},"end":{"line":11,"column":1}},"key":"RkdK4LCBLp"}],"key":"UPLXgYBzGR"},{"type":"paragraph","position":{"start":{"line":13,"column":1},"end":{"line":13,"column":1}},"children":[{"type":"text","value":"Density plots are particularly useful for larger datasets.","position":{"start":{"line":13,"column":1},"end":{"line":13,"column":1}},"key":"ADQBYQZIQf"}],"key":"EthaxMMHIw"}],"key":"YJ9f54Vh6G"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Creating a density plot from scratch","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"y4TixONJP2"}],"identifier":"creating-a-density-plot-from-scratch","label":"Creating a density plot from scratch","html_id":"creating-a-density-plot-from-scratch","implicit":true,"key":"g3mzdDtUte"}],"key":"MmMoQFDGVL"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Density plots are construced using a method called ","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"KzQVMujErF"},{"type":"strong","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"kernel density estimation","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"UFKTJdaYmU"}],"key":"OedrGEOoc1"},{"type":"text","value":" (KDE).","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"hGtbGJ2sSR"}],"key":"f5otEucsnj"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"Hence their being called KDE plots, as in Pandas (see below).","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"bFhOiLuwcX"}],"key":"G2qacy9qxe"},{"type":"paragraph","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"children":[{"type":"text","value":"The image below gives a good idea of how they are constructed.","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"UYk0GVVQQC"}],"key":"aQ5R80kw0O"},{"type":"paragraph","position":{"start":{"line":7,"column":1},"end":{"line":7,"column":1}},"children":[{"type":"text","value":"For data point, a gaussian distribution is generated. These are the kernels.","position":{"start":{"line":7,"column":1},"end":{"line":7,"column":1}},"key":"CiH1L1FDO5"}],"key":"izW3lA61Jy"},{"type":"paragraph","position":{"start":{"line":9,"column":1},"end":{"line":9,"column":1}},"children":[{"type":"text","value":"Then, these kernels are added up to produce the emergent curve.","position":{"start":{"line":9,"column":1},"end":{"line":9,"column":1}},"key":"FYfHVcP8FY"}],"key":"rUW76XG1QK"},{"type":"paragraph","position":{"start":{"line":11,"column":1},"end":{"line":11,"column":1}},"children":[{"type":"text","value":"In practice the algorithm may be more complicated — for example the parameters of the kernals may vary — but this is the essential idea.","position":{"start":{"line":11,"column":1},"end":{"line":11,"column":1}},"key":"l8ptjPzoTm"}],"key":"donb6Mkk2m"}],"key":"BCkiKlFemp"},{"type":"block","kind":"notebook-content","children":[{"type":"image","url":"/DS2023/build/kde-method-f364a70c3d518cd0653ff5e4f2028e66.png","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"F42oFm2nLm","urlSource":"images/kde-method.png"}],"key":"XfLprBVSNP"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"The plot above is produced by the following code.","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"woQHFzUS2e"}],"key":"cdPwYTSrDy"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"This code shows clearly how the plot is constructed.","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"VymnUoJ4tx"}],"key":"O7WLIH8ZJo"}],"key":"SQBoA0rG6r"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"import pandas as pd\nimport numpy as np\nimport matplotlib.pyplot as plt\nimport seaborn as sns","key":"Epb57NHJ0a"},{"type":"outputs","id":"9EHpglxnO4qI5w_PRCPkf","children":[],"key":"cuRXUoSm2n"}],"key":"GLXnmSKwTM"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"# 1. Define 5 sample data points\ndata = np.array([1.5, 2.2, 3.0, 3.5, 5.0])\n\n# 2. Create an x-axis grid for the curves\nx = np.linspace(-1, 8, 400)","key":"uJHNwgaiM9"},{"type":"outputs","id":"kdAVwznU94wzJ1oxGSfOC","children":[],"key":"Ch68NDEsRV"}],"key":"if7pOBJnlP"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"# 3. Set the bandwidth (width of each little Gaussian)\nbandwidth = 0.5\n\n# Create the canvas\nplt.figure(figsize=(9, 5))\n\n# 4. Plot the raw data points along the bottom axis (the \"rug\")\nplt.plot(data, np.zeros_like(data), 'ro', markersize=8, label='Data Points', zorder=5)\n\n# 5. Compute and plot individual Gaussians for each point\nindividual_gaussians = []\nfor point in data:\n    \n    # Standard formula for a Gaussian curve -- THE KERNEL\n    gaussian = (1 / (bandwidth * np.sqrt(2 * np.pi))) * np.exp(-0.5 * ((x - point) / bandwidth) ** 2)\n    \n    # Scale down by total number of points so the cumulative area equals 1\n    scaled_gaussian = gaussian / len(data)\n    individual_gaussians.append(scaled_gaussian)\n    \n    # Plot each little curve as a dashed gray line\n    plt.plot(x, scaled_gaussian, color='gray', linestyle='--', alpha=0.7)\n\n# 6. Sum all the individual curves together to get the final line\nemergent_density = np.sum(individual_gaussians, axis=0)\n\n# Plot the final density curve\nplt.plot(x, emergent_density, color='blue', linewidth=2.5, label='Emergent Density Curve')\n\n# Formatting the graph\nplt.title('How a Density Plot is Built from Individual Gaussians')\nplt.xlabel('X Axis')\nplt.ylabel('Density')\nplt.legend()\nplt.grid(True, alpha=0.3)\n\n# Display the plot\nplt.show()","key":"xV5lix8KTZ"},{"type":"outputs","id":"5A_3rcvp-esPaHu17eqCo","children":[{"type":"output","jupyter_data":{"output_type":"display_data","metadata":{},"data":{"image/png":{"content_type":"image/png","hash":"dbff29d012c71399bb4609ca21f95bd4","path":"/DS2023/build/dbff29d012c71399bb4609ca21f95bd4.png"},"text/plain":{"content":"<Figure size 900x500 with 1 Axes>","content_type":"text/plain"}}},"children":[],"key":"E2Ey8QXIpn"}],"key":"TgdVOAagFC"}],"key":"n6i8FziHg8"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Using Pandas KDE function","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"X1E10rRk1H"}],"identifier":"using-pandas-kde-function","label":"Using Pandas KDE function","html_id":"using-pandas-kde-function","implicit":true,"key":"fktT2xboSu"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"Let’s use the data set we used in our discussion of Histograms.","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"Xs1NhcTYDc"}],"key":"z4o9VRyOfP"}],"key":"adehfaVui2"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"healthexp = sns.load_dataset('healthexp')\nhealthexp.head()","key":"oZsmCiD5vE"},{"type":"outputs","id":"iWJU2kehDH4Yo-CWBejyB","children":[{"type":"output","jupyter_data":{"output_type":"execute_result","execution_count":4,"metadata":{},"data":{"text/html":{"content":"<div>\n<style scoped>\n    .dataframe tbody tr th:only-of-type {\n        vertical-align: middle;\n    }\n\n    .dataframe tbody tr th {\n        vertical-align: top;\n    }\n\n    .dataframe thead th {\n        text-align: right;\n    }\n</style>\n<table border=\"1\" class=\"dataframe\">\n  <thead>\n    <tr style=\"text-align: right;\">\n      <th></th>\n      <th>Year</th>\n      <th>Country</th>\n      <th>Spending_USD</th>\n      <th>Life_Expectancy</th>\n    </tr>\n  </the