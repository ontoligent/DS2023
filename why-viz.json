"},{"type":"block","kind":"notebook-code","data":{"deletable":true,"editable":true,"slideshow":{"slide_type":"skip"},"tags":[]},"children":[{"type":"code","lang":"python","executable":true,"value":"# import plotly.express as px\nimport pandas as pd\nimport matplotlib.pyplot as plt\nimport seaborn as sns\nsns.set_theme(style='darkgrid')\n\ndf = pd.DataFrame(\n    dict(\n        Country = [\"USA\",\"China\",\"Japan\",\"Germany\",\"India\",\"Brazil\"],\n        Population = [331,1441,126,83,1380,213],\n        GDP = [23.0,17.7,4.9,4.2,3.1,1.6]\n    )\n).set_index('Country')\n\nax = df.plot.scatter(x='Population', y='GDP', figsize=(10,10))\nfor idx, row in df.iterrows():\n    y_pad = 0 if idx != 'Germany' else -.1\n    ax.text(row['Population']+20, row['GDP']+y_pad, idx)\nsns.despine()\nplt.show()","visibility":"hide","key":"Xn85jc2PrJ"},{"type":"outputs","id":"i2ta8Z0ovLULmrtbo8Bhy","children":[{"type":"output","jupyter_data":{"output_type":"display_data","metadata":{},"data":{"image/png":{"content_type":"image/png","hash":"7a96f2770256155b1bcc2a7f4e39ff63","path":"/DS2023/build/7a96f2770256155b1bcc2a7f4e39ff63.png"},"text/plain":{"content":"<Figure size 1000x1000 with 1 Axes>","content_type":"text/plain"}}},"children":[],"key":"u1mmF2N3Gn"}],"visibility":"show","key":"pJcreZYhHB"}],"visibility":"show","key":"Cveu732mGz"}],"key":"F5quSJdWjw"},"references":{"cite":{"order":[],"data":{}}},"footer":{"navigation":{"prev":{"title":"Setting Up Your Environment","url":"/setting-up","group":"Unit 1 Introduction"},"next":{"title":"Introducing Pandas","url":"/pandas","group":"Unit 2 On Data"}}},"domain":"http://localhost:3000"}