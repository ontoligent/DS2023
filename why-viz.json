,"tags":[]},"children":[{"type":"code","lang":"python","executable":true,"value":"# import plotly.express as px\nimport pandas as pd\nimport matplotlib.pyplot as plt\nimport seaborn as sns\nsns.set_theme(style='darkgrid')\n\ndf = pd.DataFrame(\n    dict(\n        Country = [\"USA\",\"China\",\"Japan\",\"Germany\",\"India\",\"Brazil\"],\n        Population = [331,1441,126,83,1380,213],\n        GDP = [23.0,17.7,4.9,4.2,3.1,1.6]\n    )\n).set_index('Country')\n\nax = df.plot.scatter(x='Population', y='GDP', figsize=(10,10))\nfor idx, row in df.iterrows():\n    y_pad = 0 if idx != 'Germany' else -.1\n    ax.text(row['Population']+20, row['GDP']+y_pad, idx)\nsns.despine()\nplt.show()","visibility":"hide","key":"IdAJmEGf5Q"},{"type":"outputs","id":"Sg90-VqF5kJJzKlJGIJvn","children":[{"type":"output","jupyter_data":{"output_type":"display_data","metadata":{},"data":{"image/png":{"content_type":"image/png","hash":"7a96f2770256155b1bcc2a7f4e39ff63","path":"/DS2023/build/7a96f2770256155b1bcc2a7f4e39ff63.png"},"text/plain":{"content":"<Figure size 1000x1000 with 1 Axes>","content_type":"text/plain"}}},"children":[],"key":"Qy98f4y3tf"}],"visibility":"show","key":"g7klWMMUte"}],"visibility":"show","key":"KOAKotlUut"}],"key":"cKHIk9mgjs"},"references":{"cite":{"order":[],"data":{}}},"footer":{"navigation":{"prev":{"title":"Setting Up Your Environment","url":"/setting-up","group":"Unit 1 Introduction"},"next":{"title":"Introducing Pandas","url":"/pandas","group":"Unit 2 On Data"}}},"domain":"http://localhost:3001"}